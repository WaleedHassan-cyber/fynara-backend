{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "app.js", "use": "@vercel/node" }
  ],
  "routes": [
    
    { "src": "/api/(.*)", "dest": "api/$1" },
    { "src": "/(.*)", "dest": "app.js" }
  ],
  "crons": [{ "path": "/api/cron-job", "schedule": "0 1 * * *" }]
}
